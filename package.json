    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "oxlint": "1.93.0",
    "prettier": "3.9.10",
    "supabase": "3.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "wrangler": "4.159.0"
  },
  "allowScripts": {
    "workerd@1.20261103.1": true,
