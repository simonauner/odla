{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "odla",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    // Inga SPA-fallback: / är den statiska startsidan, workern ger /app/* appens HTML.
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    // Publika värden (publishable key är gjord för att synas i klienten; RLS skyddar datat).
    "SUPABASE_URL": "https://haiidlamhbdgfugosykm.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_tYOgTxfkWTixtqvhY_q0VQ_KeYfzgH-",
  },
}
